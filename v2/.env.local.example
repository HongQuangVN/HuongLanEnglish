# Copy file này thành .env.local rồi điền giá trị thật.
# .env.local KHÔNG được commit lên Git (đã có trong .gitignore mặc định
# của Next.js) — khác với config.js cũ, giờ key không nằm trên GitHub nữa,
# dù bản chất anon key vẫn "được phép" lộ ra browser khi build.

NEXT_PUBLIC_SUPABASE_URL=https://youyvaplxylaejhvoiya.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dán-anon-key-của-bạn-vào-đây
